{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CORS": {
    "AllowedOrigins": [ "https://localhost:3000", "http://localhost:3000" ],
    "AllowedHeaders": [],
    "AllowedMethods": [],
    "PreflightMaxAge": 1
  },
  "MessageBroker": {
    "Host": "amqp://localhost:5672",
    "ConnectionString": "Endpoint=${AZURE_SERVICE_BUS_ENDPOINT};SharedAccessKeyName=${AZURE_SERVICE_BUS_KEY_NAME};SharedAccessKey=${AZURE_SERVICE_BUS_KEY}"
  }
}
